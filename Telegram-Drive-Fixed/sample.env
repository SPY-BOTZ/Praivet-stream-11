# ==========================================
# Telegram-Drive Configuration
# ==========================================

# 1. Telegram API Credentials (from https://my.telegram.org)
API_ID=1234567
API_HASH=abcdef1234567890abcdef1234567890

# 2. Main Bot Token (Used for Telegram Bot Mode and link generation)
MAIN_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# 3. Worker Bot Tokens (Comma-separated bot tokens for multi-worker downloading & streaming)
BOT_TOKENS=1234567890:ABCdefGHIjklMNOpqrSTUvwxyz

# 4. Optional: Telegram Premium Account String Sessions (Enables 4GB file uploads/streams)
STRING_SESSIONS=

# 5. Telegram Storage Channel ID (Must add bot as admin with post permissions)
# Channel IDs typically start with -100
STORAGE_CHANNEL=-1001234567890

# 6. Database Backup Message ID (Send any file to your channel and put its message ID here)
DATABASE_BACKUP_MSG_ID=2

# 7. Website Admin Password (for web drive access)
ADMIN_PASSWORD=admin

# 8. Website Public URL (CRITICAL: Used by Bot Mode to generate direct download & stream links!)
# Example: https://my-tg-drive.koyeb.app OR https://yourdomain.com
WEBSITE_URL=https://my-tg-drive.koyeb.app

# 9. Telegram Admin IDs (Comma-separated Telegram user IDs who can control Bot Mode)
TELEGRAM_ADMIN_IDS=123456789

# 10. Database Backup Interval (in seconds, default: 60)
DATABASE_BACKUP_TIME=60

# 11. Sleep Threshold on Telegram FloodWait (in seconds, default: 60)
SLEEP_THRESHOLD=60
